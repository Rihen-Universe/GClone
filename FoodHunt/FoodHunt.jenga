#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""FoodHunt - fichier projet Jenga (genere par NKCode)."""

from Jenga import *
from Jenga.GlobalToolchains import RegisterJengaGlobalToolchains

RegisterJengaGlobalToolchains()

with project("FoodHunt"):
    consoleapp()
    language("C++")
    cppdialect("C++17")
    location(".")
    
    files(["src/**.cpp", "src/**.c"])
    includedirs(["src/"])
    
    objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}/%{prj.name}")
    
    apppublisher("Rihen Universe")
    appversion("0.1.0")
    licensefile("../../LICENSE")
    
    usenkcanvas()
    
    # appicon("Resources/nkcraft_icon.png")

    with filter("system:Windows && !options:windows-runtime=uwp && !system:XboxSeries && !system:XboxOne"):
        windowedapp()
        defines(["WIN32_LEAN_AND_MEAN", "_UNICODE", "UNICODE"])
        _WIN_LINKS = [
            "user32", "gdi32", "opengl32", "dwmapi", "shell32",
            "mf", "mfplat", "mfreadwrite", "mfuuid",
            "uuid", "ole32", "dinput8", "dxguid",
            "d3d11", "d3d12", "dxgi", "d3dcompiler",
            "avrt", "winmm",   # NKAudio (WASAPI / MMCSS)
        ]
        links(_WIN_LINKS)

    with filter("system:Linux && options:linux-backend=headless || system:Linux && options:headless"):
        windowedapp()
        usetoolchain("clang-native")
        # Suffixe -headless : binaire distinct des autres backends Linux
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-headless/%{prj.name}")
        targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-headless/%{prj.name}")
        defines(["NKENTSEU_FORCE_WINDOWING_NOOP_ONLY"])
        links(["pthread"])

    with filter("system:Linux && options:linux-backend=xlib || system:Linux && !options:linux-backend && !options:headless"):
        windowedapp()
        usetoolchain("clang-native")
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-xlib/%{prj.name}")
        targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-xlib/%{prj.name}")
        defines(["NKENTSEU_FORCE_WINDOWING_XLIB_ONLY"])
        # Xrandr : moniteurs/DPI (NkXLibWindow/EventSystem) ; asound : NKAudio (ALSA)
        links(["pthread", "X11", "Xext", "Xrandr", "GL", "asound"])

    with filter("system:Linux && options:linux-backend=xcb"):
        windowedapp()
        usetoolchain("clang-native")
        objdir("%{wks.location}/Build/Obj/%{cfg.buildcfg}-%{cfg.system}-xcb/%{prj.name}")
        targetdir("%{wks.location}/Build/Bin/%{cfg.buildcfg}-%{cfg.system}-xcb/%{prj.name}")
        defines(["NKENTSEU_FORCE_WINDOWING_XCB_ONLY"])
        links(["pthread", "xcb", "xcb-image", "xcb-icccm", "xcb-randr", "xcb-xfixes", "X11", "X11-xcb", "Xext", "xkbcommon", "xkbcommon-x11", "GL", "asound"])
        ldflags(["-fuse-ld=lld"])

    with filter("system:macOS"):
        windowedapp()
        usetoolchain("clang-native")
        # Metal + AudioUnit : MESURES sur l edition de liens de la CI macOS du
        # 2026-08-27, pas devines. NKCanvas embarque son backend Metal
        # (MTLCreateSystemDefaultDevice, MTLRenderPassDescriptor,
        # MTLTextureDescriptor) et NKAudio son backend CoreAudio
        # (AudioComponent*, AudioOutputUnit*, AudioUnit*). Les 23 projets
        # COMPILENT sans ces frameworks : seul le lien final tombe.
        frameworks(["Cocoa", "QuartzCore", "OpenGL", "Metal", "AudioToolbox", "CoreAudio", "AudioUnit"])

    with filter("system:Android"):
        windowedapp()
        usetoolchain("android-ndk")
        androidapplicationid("com.nkentseu.nkludo")
        androidisgame(True)
        androidminsdk(24)
        androidtargetsdk(34)
        androidcompilesdk(34)
        androidabis(["armeabi-v7a", "arm64-v8a", "x86", "x86_64"])
        androidnativeactivity(True)
        # PORTRAIT : c'est l'orientation du jeu (plateau carre + HUD au-dessus,
        # cf. NkGemLayout::Compute). La valeur precedente, "landscape", venait
        # du descripteur de Mou dont ce fichier est une copie.
        # NOTE : la mise en page SAIT faire les deux (colonne a gauche en
        # paysage) ; c'est un choix de produit, pas une limite technique.
        androidscreenorientation("portrait")
        androidallowrotation(False)
        androidstl("c++_shared")
        # androidassets : rien a embarquer (voir le commentaire sur dependfiles).
        # OpenSLES + dl requis par NKAudio sur Android
        _ANDROID_LINKS = ["android", "log", "EGL", "GLESv3", "dl", "OpenSLES"]
        links(_ANDROID_LINKS)

    with filter("system:iOS"):
        windowedapp()
        # Memes symboles manquants que sur macOS (voir ce filtre), mais PAS la
        # meme liste de frameworks :
        #   ⚠️ "AudioUnit" N EXISTE PAS sur iOS. C est un framework separe sur
        #   macOS seulement ; sur iOS ses symboles (AudioComponent*,
        #   AudioOutputUnit*, AudioUnit*) vivent dans AudioToolbox. Recopier la
        #   liste macOS a rendu "ld: framework AudioUnit not found" — mesure de
        #   la CI iOS du 2026-08-27. Un precedent se verifie sur SA plateforme.
        frameworks(["UIKit", "QuartzCore", "OpenGLES", "AVFoundation", "Metal", "AudioToolbox", "CoreAudio"])
        iosbundleid("com.nkentseu.nkludo")
        iosversion("1.0")
        iosminsdk("14.0")
        iosbuildnumber(1)

    with filter("system:Web"):
        consoleapp()
        usetoolchain("emscripten")
        defines(["NKENTSEU_ENABLE_EMSCRIPTEN"])
        # Pas de coquille HTML propre au jeu : Applications/Gemcrush/web/ n'existe
        # pas (le chemin venait de Mou). Jenga utilise sa coquille par defaut.
        emscriptencanvasid("canvas")
        emscripteninitialmemory(32)
        emscriptenextraflags([
            "-s", "ASYNCIFY",
            "-s", "ALLOW_MEMORY_GROWTH=1",
            "-s", "FULL_ES3=1",
            "-s", "USE_WEBGL2=1",
            "-s", "NO_EXIT_RUNTIME=1",
        ])

    with filter("system:HarmonyOS"):
        windowedapp()
        usetoolchain("ohos-ndk")
        harmonybundlename("com.nkentseu.nkludo")
        harmonyminsdk(12)
        harmonytargetapi(12)
        # PORTRAIT, exactement comme sur Android (androidscreenorientation
        # ci-dessus). Sans orientation DECLAREE, le systeme impose la sienne et
        # l'image sort tournee d'un quart de tour.
        harmonyorientation("portrait")
        links(["hilog_ndk.z", "EGL", "GLESv3", "vulkan"])

    with filter("config:Debug"):
        defines(["_DEBUG", "DEBUG"])
        optimize("Off")
        symbols(True)

    with filter("config:Release"):
        defines(["NDEBUG"])
        optimize("Speed")
        symbols(False)

    with filter("system:Windows"):
        usetoolchain("clang-mingw")

    with filter("system:Android"):
        usetoolchain("android-ndk")

    with filter("system:Web"):
        usetoolchain("emscripten")

    with filter("system:HarmonyOS"):
        usetoolchain("ohos-ndk")

    with filter("system:Android"):
        androidapplicationid("com.rihen.monapp")
        androidminsdk(24)
        androidtargetsdk(31)
        androidcompilesdk(31)
        androidabis(["arm64-v8a", "x86_64"])
